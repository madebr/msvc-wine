{
  "version": "8.0",
  "compiler-paths": {
    "host": {
      "x86": {
        "target": {
          "x86": {
            "path": [
              "VC/bin",
              "Common7/Tools",
              "Common7/Tools/Bin"
            ]
          }
        }
      }
    }
  },
  "sdk-paths": {
